# Local machine recovery output: Dropbox file inventories (full personal file
# listings), Codex AI session rollouts, and Codex global state. The rollout
# transcripts were verified on 2026-08-04 to contain live `sk-` API tokens.
recovery-manifests/

# Tool run output: per-run folders holding Dropbox cleanup workbooks and
# inspection dumps. These enumerate personal file paths and media inventories.
outputs/

